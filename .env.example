# Copie para .env (no Windows: copy .env.example .env)

# Chave que assina os tokens JWT. Use uma frase longa e aleatória.
JWT_SECRET=troque-esta-chave-por-uma-string-longa-e-aleatoria
JWT_EXPIRES_IN=7d
POSTGRES_PASSWORD=sos

# Endereço da API embutido no APK (com barra no final):
#   emulador Android -> http://10.0.2.2:3000/
#   celular físico   -> http://IP_DO_SEU_PC:3000/  (veja "Endereço IPv4" no ipconfig)
SOS_API_URL=http://10.0.2.2:3000/

# Endereço da API usado pelo navegador que abre o painel
PAINEL_API_URL=http://localhost:3000
